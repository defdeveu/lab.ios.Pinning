// Hosted endpoint defaults for the classroom environment.
LAB_URL_SLASH = /
LAB_PINNING_URL = https:$(LAB_URL_SLASH)$(LAB_URL_SLASH)zsk.labs.def.dev/pinning/success

// Current hosted leaf pin, applied 2026-09-29. Certificate renewal changes this
// value; refresh it from the hosted material bundle, see MANUAL.md.
LAB_LEAF_PIN = sha256/PlnlvxfcGEEUs/29JFwFdOb2lQKErvisb/6LqfXrlOw=

// A gitignored Local.xcconfig overrides the values above when it is present;
// #include? is an optional include, so ordinary builds are unaffected.
#include? "Local.xcconfig"
