// Copy to Local.xcconfig for a local development session. Hosted.xcconfig
// includes that ignored file when it is present, so it needs no Xcode
// selection step.
LAB_URL_SLASH = /
LAB_HTTP_URL = http:$(LAB_URL_SLASH)$(LAB_URL_SLASH)127.0.0.1:8080/pinning/success
LAB_HTTPS_URL = https:$(LAB_URL_SLASH)$(LAB_URL_SLASH)localhost:8443/pinning/success
