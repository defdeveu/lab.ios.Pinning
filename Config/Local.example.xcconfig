// Copy to Local.xcconfig for a local development session. Hosted.xcconfig
// includes that ignored file when it is present, so it needs no Xcode
// selection step. LAB_LEAF_PIN is the leaf pin `make local-pin` prints while
// the local edge runs.
LAB_URL_SLASH = /
LAB_PINNING_URL = https:$(LAB_URL_SLASH)$(LAB_URL_SLASH)localhost:8443/pinning/success
LAB_LEAF_PIN = sha256/REPLACE_WITH_LOCAL_LEAF_PIN
